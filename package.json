{
  "name": "asvri",
  "version": "1.1.2",
  "description": "ASVRI's API for Node.js: checkout sessions that take payment through every gateway you've connected, cards on file (setup sessions, saved payment methods, charges), refunds, webhook endpoints and webhook signature checks.",
  "keywords": ["asvri", "payments", "checkout", "paystack", "flutterwave", "webhooks", "africa"],
  "homepage": "https://www.asvri.com/developers",
  "repository": { "type": "git", "url": "git+https://github.com/asvri/asvri-node.git" },
  "bugs": { "url": "https://github.com/asvri/asvri-node/issues" },
  "license": "MIT",
  "author": "ASVRI",
  "type": "module",
  "engines": { "node": ">=18" },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "~5.9.3"
  }
}
